{
  "name": "kit42",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "check:lint": "turbo run check:lint",
    "check:format": "oxfmt --check",
    "check:types": "turbo run check:types",
    "check:all": "npm run check:lint && npm run check:format && npm run check:types",
    "fix:lint": "turbo run fix:lint",
    "fix:format": "oxfmt",
    "fix:all": "npm run fix:lint && npm run fix:format"
  },
  "devDependencies": {
    "@kit42/ox": "*",
    "oxfmt": "^0.42.0",
    "turbo": "^2.8.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.7.0"
}
