{
  "name": "draft0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run",
    "start": "turbo run start",
    "check:lint": "oxlint",
    "check:fmt": "oxfmt --check",
    "check": "npm run check:lint && npm run check:fmt",
    "fix:lint": "oxlint --fix",
    "fix:fmt": "oxfmt",
    "fix": "npm run fix:lint && npm run fix:fmt"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@draft0/oxfmt": "*",
    "@draft0/oxlint": "*",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.5",
    "turbo": "^2.9.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.7.0"
}
