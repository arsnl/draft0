{
  "name": "kit42",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "check:lint": "turbo run check:lint",
    "check:format": "prettier --check .",
    "check:types": "turbo run check:types",
    "check:all": "npm run check:lint && npm run check:format && npm run check:types",
    "fix:lint": "turbo run fix:lint",
    "fix:format": "prettier --write --log-level warn .",
    "fix:all": "npm run fix:lint && npm run fix:format"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ]
}
