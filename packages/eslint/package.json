{
  "name": "@kit42/eslint",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "rm -rf dist && tsc --watch -p tsconfig.build.json",
    "build": "rm -rf dist && tsc --build -p tsconfig.build.json",
    "check:lint": "eslint .",
    "check:types": "tsc --noEmit",
    "fix:lint": "eslint --fix ."
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./configs/*": {
      "import": "./dist/configs/*/config.js",
      "types": "./dist/configs/*/config.d.ts"
    }
  },
  "devDependencies": {
    "@kit42/tsconfig": "*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "eslint-plugin-compat": "^7.0.1",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-perfectionist": "^5.7.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.3.0",
    "typescript-eslint": "^8.54.0"
  }
}
