{
  "name": "@draft0/oxfmt",
  "version": "0.0.0",
  "description": "Opinionated Oxfmt to help you ship faster.",
  "keywords": [
    "config",
    "draft0",
    "format",
    "formatter",
    "oxfmt"
  ],
  "homepage": "https://draft0.dev",
  "bugs": {
    "url": "https://github.com/arsnl/draft0/issues"
  },
  "license": "MIT",
  "author": "arsnl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsnl/draft0.git",
    "directory": "packages/oxfmt"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown"
  },
  "devDependencies": {
    "@draft0/tsconfig": "*",
    "@draft0/tsdown": "*",
    "oxfmt": "0.47.0"
  },
  "peerDependencies": {
    "oxfmt": "^0.47.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
