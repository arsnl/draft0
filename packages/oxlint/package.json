{
  "name": "@draft0/oxlint",
  "version": "0.0.0",
  "description": "Opinionated Oxlint presets to help you ship faster.",
  "keywords": [
    "config",
    "draft0",
    "eslint",
    "lint",
    "oxlint"
  ],
  "homepage": "https://github.com/arsnl/draft0",
  "bugs": {
    "url": "https://github.com/arsnl/draft0/issues"
  },
  "license": "MIT",
  "author": "arsnl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsnl/draft0.git",
    "directory": "packages/oxlint"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown"
  },
  "dependencies": {
    "oxlint-plugin-eslint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "type-fest": "^5.6.0"
  },
  "devDependencies": {
    "@draft0/tsconfig": "*",
    "@draft0/tsdown": "*",
    "oxlint": "1.62.0"
  },
  "peerDependencies": {
    "oxlint": "^1.62.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
