{
  "name": "@kit42/oxlint",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./configs/*": {
      "types": "./dist/configs/*/config.d.ts",
      "import": "./dist/configs/*/config.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "import": "./dist/oxfmt.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "check:lint": "oxlint",
    "fix:lint": "oxlint --fix",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "oxlint-plugin-eslint": "^1.57.0",
    "oxlint-tsgolint": "^0.18.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@kit42/tsconfig": "*",
    "oxlint": "^1.57.0",
    "publint": "^0.3.18",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "oxlint": "^1.57.0"
  },
  "engines": {
    "node": ">=22"
  }
}
