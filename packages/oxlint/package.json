{
  "name": "@kit42/oxlint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./configs/*": {
      "import": "./dist/configs/*/config.js",
      "types": "./dist/configs/*/config.d.ts"
    }
  },
  "scripts": {
    "dev": "rm -rf dist && tsc --watch -p tsconfig.build.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:lint": "oxlint .",
    "fix:lint": "eslint --fix .",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "oxlint-plugin-eslint": "^1.57.0",
    "oxlint-tsgolint": "^0.18.1"
  },
  "devDependencies": {
    "@kit42/tsconfig": "*",
    "oxlint": "^1.57.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "oxlint": "^1.57.0"
  }
}
