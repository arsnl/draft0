{
  "$schema": "https://www.schemastore.org/tsconfig",
  "display": "bundler / no DOM / lib (monorepo, declaration emit)",
  "extends": ["../../base.json"],
  "compilerOptions": {
    "lib": ["es2025", "esnext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "noUncheckedSideEffectImports": true
  }
}
