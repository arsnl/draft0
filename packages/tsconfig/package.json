{
  "name": "@draft0/tsconfig",
  "version": "0.1.0",
  "description": "Opinionated tsconfig presets to help you ship faster.",
  "keywords": [
    "config",
    "draft0",
    "tsconfig",
    "typescript"
  ],
  "homepage": "https://draft0.dev",
  "bugs": {
    "url": "https://github.com/arsnl/draft0/issues"
  },
  "license": "MIT",
  "author": "arsnl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsnl/draft0.git",
    "directory": "packages/tsconfig"
  },
  "files": [
    "presets"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": "./presets/core.json",
    "./tsc/dom/*": "./presets/tsc/dom/*.json",
    "./tsc/no-dom/*": "./presets/tsc/no-dom/*.json",
    "./bundler/dom/*": "./presets/bundler/dom/*.json",
    "./bundler/no-dom/*": "./presets/bundler/no-dom/*.json",
    "./frameworks/*": "./presets/frameworks/*.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
