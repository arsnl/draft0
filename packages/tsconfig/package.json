{
  "name": "@draft0/tsconfig",
  "version": "0.0.0",
  "description": "Opinionated tsconfig presets to help you ship faster.",
  "keywords": [
    "config",
    "draft0",
    "tsconfig",
    "typescript"
  ],
  "homepage": "https://github.com/arsnl/draft0",
  "bugs": {
    "url": "https://github.com/arsnl/draft0/issues"
  },
  "license": "MIT",
  "author": "arsnl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsnl/draft0.git",
    "directory": "packages/tsconfig"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./base": "./src/base.json",
    "./tsc/dom/*": "./src/tsc/dom/*.json",
    "./tsc/no-dom/*": "./src/tsc/no-dom/*.json",
    "./bundler/dom/*": "./src/bundler/dom/*.json",
    "./bundler/no-dom/*": "./src/bundler/no-dom/*.json",
    "./frameworks/*": "./src/frameworks/*.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
