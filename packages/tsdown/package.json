{
  "name": "@draft0/tsdown",
  "version": "0.1.0",
  "description": "Opinionated tsdown config helper to help you ship faster.",
  "keywords": [
    "build",
    "draft0",
    "tsdown",
    "typescript"
  ],
  "homepage": "https://draft0.dev",
  "bugs": {
    "url": "https://github.com/arsnl/draft0/issues"
  },
  "license": "MIT",
  "author": "arsnl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsnl/draft0.git",
    "directory": "packages/tsdown"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
