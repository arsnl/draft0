  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown"
  },
  "dependencies": {
    "@arethetypeswrong/core": "^0.18.3",
    "publint": "^0.3.21",
    "type-fest": "^5.7.0"
  },
  "devDependencies": {
    "@draft0/tsconfig": "*",
    "tsdown": "0.22.2"
  },
  "peerDependencies": {
    "tsdown": "^0.22.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
